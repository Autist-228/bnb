# Solana RPC Configuration
# Public (free, rate-limited) or private (Helius, QuickNode, etc.)
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
SOLANA_HTTP_URL=https://api.mainnet-beta.solana.com

# Paper Trading Budget
BUDGET_USD=50
SOL_PRICE_USD=140

# Trade Parameters
BUY_AMOUNT_SOL=0.02
TAKE_PROFIT_PCT=100
STOP_LOSS_PCT=30
TIMEOUT_SECONDS=300
MAX_POSITIONS_PER_STRATEGY=5

# Strategy: King of the Hill
KOTH_MIN_CURVE_PCT=40
KOTH_MAX_CURVE_PCT=65
KOTH_MIN_UNIQUE_BUYERS=12
KOTH_MIN_VELOCITY=0.3

# Strategy: Velocity Spike
VELOCITY_SPIKE_MULTIPLIER=3.0
VELOCITY_MIN_CURVE_PCT=10
VELOCITY_MIN_UNIQUE_BUYERS=8
VELOCITY_WINDOW_SECONDS=60

# Strategy: Migration Moment
MIGRATION_HOLD_SECONDS=300
